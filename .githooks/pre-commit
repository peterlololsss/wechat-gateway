#!/bin/sh
set -eu

PATTERN='([0-9]{1,3}[.]){3}[0-9]{1,3}|[A-Za-z0-9._-]+[.]ts[.]net|/home/[A-Za-z0-9._-]+/|/Users/[A-Za-z0-9._-]+/|wxid_[A-Za-z0-9_-]+|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9_]{36,}|github_pat_[A-Za-z0-9_]+|-----BEGIN [A-Z ]*PRIVATE KEY-----'

if git diff --cached --name-only -z | xargs -0 -r grep -I -n -E "$PATTERN"; then
  echo "Sensitive-looking literal detected in staged changes. Redact it or use an approved placeholder before committing." >&2
  exit 1
fi